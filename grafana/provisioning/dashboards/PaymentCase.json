{
 "title": "Payment case metrics",
 "uid": "payment-case-metrics",
 "schemaVersion": 40,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Incoming vs outgoing vs completed (rps)",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(rate(payment_incoming_total[1m]))",
     "legendFormat": "incoming",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(rate(payment_outgoing_total[1m]))",
     "legendFormat": "outgoing",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(rate(payment_completed_total[1m]))",
     "legendFormat": "completed",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(rate(payment_rejected_total[1m])) + sum(rate(payment_rejected_sync_total[1m]))",
     "legendFormat": "rejected",
     "refId": "D"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Completed by result (rps)",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum by (result) (rate(payment_completed_total[1m]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Pending in adapter (queue + in flight)",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(payment_pending)",
     "legendFormat": "pending",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Totals",
   "datasource": {
    "type": "prometheus",
    "uid": "PBFA97CFB590B2093"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "noValue": "0",
     "custom": {
      "drawStyle": "line",
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(payment_incoming_total)",
     "legendFormat": "incoming",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(payment_outgoing_total)",
     "legendFormat": "outgoing",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(payment_completed_total)",
     "legendFormat": "completed",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "PBFA97CFB590B2093"
     },
     "expr": "sum(payment_rejected_total) + sum(payment_rejected_sync_total)",
     "legendFormat": "rejected",
     "refId": "D"
    }
   ]
  }
 ]
}